{
  "name": "worldcup-atlas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "assets:icons": "tsx scripts/assets/generate-icons.ts",
    "data:download": "tsx scripts/import/download-fjelstul.ts",
    "data:import": "tsx scripts/import/import-fjelstul.ts",
    "data:inspect": "tsx scripts/import/inspect-fjelstul.ts",
    "data:verify": "tsx scripts/verify/verify-counts.ts",
    "fixtures:sync": "tsx scripts/fixtures/sync-2026-fixtures.ts",
    "data:2026:collect": "tsx scripts/2026/collect-2026-sources.ts",
    "data:2026:candidates": "tsx scripts/2026/build-2026-candidates.ts",
    "data:2026:normalize": "tsx scripts/2026/normalize-2026-data.ts",
    "data:2026:validate": "tsx scripts/2026/validate-2026-data.ts",
    "data:2026:manual-pack": "tsx scripts/2026/inspect-manual-reference-pack.ts",
    "data:2026:display-schedule": "tsx scripts/2026/build-2026-display-schedule.ts",
    "data:2026:mominul:approved-pack": "tsx scripts/2026/build-mominul-approved-pack.ts",
    "data:2026:mominul:import": "tsx scripts/2026/import-mominul-2026.ts --dry-run",
    "data:2026:mominul:import:write": "tsx scripts/2026/import-mominul-2026.ts --write",
    "data:2026:mominul:inspect": "tsx scripts/2026/inspect-mominul-provider.ts",
    "data:2026:bustami:inspect": "tsx scripts/2026/inspect-bustami-provider.ts",
    "data:2026:full-check": "pnpm data:2026:normalize && pnpm data:2026:validate",
    "data:2026:collect-and-check": "pnpm data:2026:collect && pnpm data:2026:candidates && pnpm data:2026:normalize && pnpm data:2026:validate",
    "media:seed": "tsx scripts/media/seed-curated-media.ts",
    "data:verify:queries": "tsx scripts/verify/verify-page-queries.ts",
    "export:verify": "tsx scripts/verify/verify-export.ts",
    "public:verify": "tsx scripts/verify/verify-public-routes.ts",
    "security:verify": "tsx scripts/verify/verify-security.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prod:preflight": "tsx scripts/verify/verify-production-readiness.ts",
    "prod:validate": "pnpm security:verify && pnpm public:verify && pnpm export:verify && pnpm search:verify && pnpm data:verify:queries && pnpm data:verify && pnpm typecheck && pnpm lint && pnpm build && pnpm test:e2e",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "clean:next": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:clean": "pnpm clean:next && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "search:index": "tsx scripts/search/build-index.mts",
    "search:verify": "tsx scripts/verify/verify-search.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "@mui/x-data-grid": "^9.3.0",
    "@next/third-parties": "16.2.12",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "^7.8.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "flag-icons": "^7.5.0",
    "meilisearch": "^0.58.0",
    "motion": "^12.40.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "hono": "4.12.27",
      "@hono/node-server": "2.0.10",
      "postcss@<8.5.18": ">=8.5.18",
      "fast-uri@3": "3.1.4",
      "valibot@1": "1.4.2",
      "js-yaml@4": "4.3.0",
      "brace-expansion@1": "1.1.17",
      "brace-expansion@5": "5.0.8",
      "sharp@<0.35.0": ">=0.35.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "sharp": "^0.35.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
