# WORLDCUP Nexus — production environment template
#
# PLACEHOLDERS ONLY. Never commit real values: set them in the hosting
# platform's environment settings (e.g. Vercel project env vars).
# Full guidance: docs/DEPLOYMENT.md, docs/PRODUCTION_RUNBOOK.md.

# --- Database (server-only secrets) ---------------------------------------
# PostgreSQL connection string used by the app at runtime and by
# `pnpm db:deploy` / data import. With a pooled provider (e.g. Supabase
# with PgBouncer), point DATABASE_URL at the POOLED endpoint.
DATABASE_URL=""
# Direct (non-pooled) connection for migrations/import. Same value as
# DATABASE_URL if your provider has no separate pooler endpoint.
DIRECT_URL=""

# --- Search -----------------------------------------------------------------
# Search is Postgres-backed (SearchDocument table in the same database) —
# no external search service and no search env vars are required. After
# deploying migrations and importing data, rebuild the index from a trusted
# admin environment with: pnpm search:index (uses DATABASE_URL).

# --- Public configuration (safe to expose) ---------------------------------
# Canonical production URL. NEXT_PUBLIC_* values are inlined into the
# client bundle — never put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL="https://your-production-domain.com"

# --- Platform ---------------------------------------------------------------
# Most platforms (Vercel) set NODE_ENV=production automatically; it gates
# the dev-only endpoint, enables HSTS, and disables debug error detail.
NODE_ENV="production"

NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- Feature flags (server-only) --------------------------------------------
# Post-tournament archive mode (the 2026 tournament is complete). Both live
# flags default OFF when missing/empty — set to "true" in the platform env
# only to re-enable live mode for a future tournament.
FEATURE_LATEST_MATCHES_SECTION=""
FEATURE_2026_FIXTURE_SYNC=""
# Archive presentation is ON unless explicitly "false".
FEATURE_2026_ARCHIVE_MODE="true"

# --- Fixture providers retained for future reuse (server-only) --------------
# Inactive while FEATURE_2026_FIXTURE_SYNC is not "true". Real provider URLs
# live only in the hosting platform's env settings — never in this file.
OPENFOOTBALL_2026_URL=""
WORLDCUP26_API_BASE_URL=""
FIXTURE_SYNC_PROVIDER_MODE="openfootball-only"
# Shared secret for the (currently disabled) sync route. Only needed if the
# sync flag is re-enabled; empty disables the route (fail closed).
CRON_SECRET=""

# --- User feedback & suggestions -------------------------------------------
# Cloudflare Turnstile. The SITE key is public (safe to inline). The SECRET
# key is server-only — set it in the hosting platform's env, never as a
# NEXT_PUBLIC_* variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis REST (server-side rate limiting). Server-only secrets. When
# unset in production the feedback API fails closed (rejects submissions).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Server-only salt for hashing abuse-prevention signals (IP / user agent).
# Raw IP addresses are never stored. Use a long random value.
FEEDBACK_HASH_SALT=""
# Optional new-feedback notification webhook (server-only). Never carries raw
# IP/user agent or full email. Leave blank to disable.
FEEDBACK_NOTIFY_WEBHOOK=""
# Optional moderator contact address (server-only).
FEEDBACK_ADMIN_EMAIL=""
# Cloudflare API credentials (server-only) — used by tooling/scripts, never the
# browser. Create a scoped API token in the Cloudflare dashboard; do not commit
# real values.
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

