# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example
!.env.production.example
.env.production.local

# Prisma generated client (regenerate with `pnpm db:generate`)
/src/generated/

# Downloaded source data and inspection reports (re-fetch with `pnpm data:download`)
data/sources/fjelstul/raw/*.csv
data/sources/fjelstul/reports/*.json

# Curated media seed input — may hold unreviewed URLs/licenses; keep it local.
# The committed .example.json documents the shape.
data/media/curated-player-media.json

# 2026 data steward agent (Phase 1) — raw snapshots and scratch outputs stay
# local (re-fetch with `pnpm data:2026:collect`). Curated small outputs
# (data/2026/normalized/, data/2026/validation/, data/2026/reports/, and
# data/2026/source-registry.json) remain committable by policy — see
# docs/2026_DATA_STEWARD_AGENT.md.
data/2026/raw/
data/2026/candidates/
data/2026/reports/tmp/
data/2026/downloads/
# Candidate-provider enrichment output can be large (per-row player stats /
# EFI metrics) and is fully regenerable with `pnpm data:2026:normalize`.
data/2026/normalized/mominul/
data/2026/normalized/bustami/

# Scratch area for files pending manual deletion (never commit)
_to_delete/

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

